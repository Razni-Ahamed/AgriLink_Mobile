# Keep every text file LF in the repository, whatever OS or editor commits it, so diffs and
# `dart format` agree on every team member's machine.
* text=auto eol=lf

*.dart text eol=lf
*.arb text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.kts text eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Never touch binary files.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ttf binary
*.otf binary
*.jar binary
*.apk binary
